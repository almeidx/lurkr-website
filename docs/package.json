{
	"name": "@lurkr/docs",
	"private": true,
	"homepage": "https://lurkr.gg/docs",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "node scripts/fetch-openapi.mjs && fumapress build && node scripts/postbuild.mjs",
		"build:cf": "pnpm run build",
		"build:typecheck": "fumadocs-mdx && tsc --noEmit",
		"deploy:cf": "pnpm run build && wrangler deploy",
		"dev": "node scripts/fetch-openapi.mjs && fumapress dev",
		"fetch:openapi": "node scripts/fetch-openapi.mjs",
		"fmt": "biome check --write --unsafe",
		"fmt:content": "oxfmt --write content",
		"format": "pnpm run fmt",
		"lint": "biome check",
		"postinstall": "fumadocs-mdx",
		"preview:cf": "pnpm run build && wrangler dev",
		"start": "fumapress start"
	},
	"dependencies": {
		"@base-ui/react": "^1.6.0",
		"fumadocs-core": "^16.15.7",
		"fumadocs-mdx": "^15.4.0",
		"fumadocs-openapi": "11.4.1",
		"fumadocs-ui": "npm:@fumadocs/base-ui@^16.15.7",
		"fumapress": "^1.2.0",
		"hono": "^4.6.0",
		"react": "^19.2.8",
		"react-dom": "^19.2.8",
		"sharp": "^0.34.0",
		"shiki": "^4.4.3",
		"waku": "1.0.0-rc.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@tailwindcss/vite": "^4.3.3",
		"@types/mdx": "^2.0.14",
		"@types/node": "^24.13.3",
		"@types/react": "^19.2.18",
		"@types/react-dom": "^19.2.7",
		"oxfmt": "^0.66.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~7.0.2",
		"vite": "^8.2.2",
		"wrangler": "^4.129.0"
	},
	"engines": {
		"node": ">=24.20.0"
	}
}
