{
	"name": "@lurkr/docs",
	"private": true,
	"homepage": "https://lurkr.gg/docs",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "node scripts/fetch-openapi.mjs && fumapress build && node scripts/postbuild.mjs",
		"build:cf": "pnpm run build",
		"build:typecheck": "fumadocs-mdx && tsc --noEmit",
		"deploy:cf": "pnpm run build && wrangler deploy",
		"dev": "node scripts/fetch-openapi.mjs && fumapress dev",
		"fetch:openapi": "node scripts/fetch-openapi.mjs",
		"fmt": "oxlint --fix && oxfmt",
		"fmt:content": "oxfmt --write content",
		"format": "pnpm run fmt",
		"lint": "oxlint && oxfmt --check",
		"postinstall": "fumadocs-mdx",
		"preview:cf": "pnpm run build && wrangler dev",
		"start": "fumapress start"
	},
	"dependencies": {
		"@base-ui/react": "catalog:",
		"fumadocs-core": "catalog:",
		"fumadocs-mdx": "catalog:",
		"fumadocs-openapi": "catalog:",
		"fumadocs-ui": "catalog:",
		"fumapress": "catalog:",
		"hono": "catalog:",
		"react": "catalog:",
		"react-dom": "catalog:",
		"sharp": "catalog:",
		"shiki": "catalog:"
	},
	"devDependencies": {
		"@tailwindcss/vite": "catalog:",
		"@types/mdx": "catalog:",
		"@types/node": "catalog:",
		"@types/react": "catalog:",
		"@types/react-dom": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"vite": "catalog:",
		"wrangler": "catalog:"
	},
	"engines": {
		"node": ">=26.13.0"
	}
}
