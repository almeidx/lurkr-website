{
	"name": "@lurkr/docs",
	"private": true,
	"homepage": "https://lurkr.gg/docs",
	"type": "module",
	"sideEffects": false,
	"scripts": {
		"build": "node scripts/fetch-openapi.mjs && fumapress build && node scripts/postbuild.mjs",
		"build:cf": "pnpm run build",
		"build:typecheck": "fumadocs-mdx && tsc --noEmit",
		"deploy:cf": "pnpm run build && wrangler deploy",
		"dev": "node scripts/fetch-openapi.mjs && fumapress dev",
		"fetch:openapi": "node scripts/fetch-openapi.mjs",
		"fmt": "oxlint --fix && oxfmt",
		"fmt:content": "oxfmt --write content",
		"format": "pnpm run fmt",
		"lint": "oxlint && oxfmt --check",
		"postinstall": "fumadocs-mdx",
		"preview:cf": "pnpm run build && wrangler dev",
		"start": "fumapress start"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
		"fumadocs-core": "^16.15.14",
		"fumadocs-mdx": "^15.4.5",
		"fumadocs-openapi": "12.0.3",
		"fumadocs-ui": "npm:@fumadocs/base-ui@^16.15.14",
		"fumapress": "^1.5.0",
		"hono": "^4.13.9",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"sharp": "^0.35.4",
		"shiki": "^4.4.3",
		"waku": "1.0.0-rc.1"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.3",
		"@types/mdx": "^2.0.14",
		"@types/node": "^24.19.0",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"oxfmt": "^0.71.0",
		"oxlint": "^1.86.0",
		"tailwindcss": "^4.3.3",
		"typescript": "~7.0.2",
		"vite": "^8.3.1",
		"wrangler": "^4.141.0"
	},
	"engines": {
		"node": ">=24.21.0"
	}
}
