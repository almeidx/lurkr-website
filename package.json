{
	"name": "lurkr-website",
	"private": true,
	"homepage": "https://lurkr.gg",
	"type": "module",
	"scripts": {
		"build": "pnpm --recursive run build",
		"build:typecheck": "pnpm --recursive run build:typecheck",
		"fmt": "oxlint --fix && oxfmt",
		"lint": "oxlint && oxfmt --check",
		"lint:ci": "oxlint --deny-warnings && oxfmt --check",
		"prepare": "husky .github/husky"
	},
	"devDependencies": {
		"@types/node": "^24.19.2",
		"husky": "^9.1.7",
		"nano-staged": "^1.0.2",
		"oxfmt": "^0.74.0",
		"oxlint": "^1.89.0",
		"oxlint-tsgolint": "^7.0.2005",
		"typescript": "~7.0.2"
	},
	"nano-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
			"oxlint --fix",
			"oxfmt --write"
		],
		"*.{json,jsonc,css}": "oxfmt --write"
	},
	"engines": {
		"node": ">=24.22.0"
	},
	"packageManager": "pnpm@12.15.0"
}
