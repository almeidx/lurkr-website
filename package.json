{
	"name": "lurkr-website",
	"private": true,
	"homepage": "https://lurkr.gg",
	"type": "module",
	"scripts": {
		"build": "pnpm --recursive run build",
		"build:typecheck": "pnpm --recursive run build:typecheck",
		"fmt": "oxlint --fix && oxfmt",
		"lint": "oxlint && oxfmt --check",
		"lint:ci": "oxlint --deny-warnings && oxfmt --check",
		"prepare": "husky .github/husky"
	},
	"devDependencies": {
		"@types/node": "catalog:",
		"husky": "catalog:",
		"nano-staged": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"typescript": "catalog:"
	},
	"nano-staged": {
		"*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
			"oxlint --fix",
			"oxfmt --write"
		],
		"*.{json,jsonc,css}": "oxfmt --write"
	},
	"engines": {
		"node": ">=26.13.0"
	},
	"packageManager": "pnpm@12.18.0"
}
